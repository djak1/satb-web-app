// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  role Roles @default(USER)

  accounts Account[]
  sessions Session[]
  
  fighters Fighter[] @relation("CreatedFighter")
  competition Competition[] @relation("CreatedCompetition")
}
model Competition{
  id String @id @default(uuid())
  name String
  location String
  date DateTime
  registrationDeadline DateTime
  createdById String

  status CompStatus @default(DRAFT)
  compReg CompetitionRegistration[]
  user User @relation("CreatedCompetition", fields: [createdById], references: [id])
}
model CompetitionRegistration{
  id String @id @default(cuid())
  competitionId String
  fighterId String
  registeredAt DateTime @default(now())
  status Statuses @default(PENDING)
  
  weight Decimal @default(0)
  experience Decimal @default(0)

  agedCategory AgedCategories @default(default)
  weightCategory Decimal @default(0)

  competitions Competition @relation(fields: [competitionId], references: [id])
  fighters Fighter @relation(fields: [fighterId], references: [id])

  @@unique([fighterId, competitionId])

}
model Fighter {
  id String @id @default(cuid())
  firstName String
  lastName String
  gender Genders
  yearOfBirth Int @default(0)
  createdById String
  clubId String

  compReg CompetitionRegistration[]
  club Club @relation(fields: [clubId], references: [id])
  user User @relation("CreatedFighter" ,fields: [createdById], references: [id])
}
model Club{ 
  id String @id @default(cuid())
  name String
  state String
  city String
  country String

  fighters Fighter[]
  coaches Coach[]
}
model Coach{
  id String @id @default(cuid())
  firstName String
  lastName String
  email String?
  telNum String?
  clubId String

  club Club @relation(fields: [clubId], references: [id])
}
enum Roles {
  ADMIN
  USER
  ORGANIZER
}
enum CompStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ACTIVE
  FINISHED
  CANCELLED
}

enum Statuses {
  PENDING
  APPROVED
  REJECTED
}

enum Genders {
  MALE
  FEMALE
}

enum AgedCategories {
  default
  U8
  U10
  U12
  U14
  U16
  U18
  U24
  MASTERS_ELITE
}